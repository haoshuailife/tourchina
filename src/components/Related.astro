---
interface RelatedItem {
  title: string;
  description: string;
  href: string;
  eyebrow?: string;
}
interface Props {
  title?: string;
  items: RelatedItem[];
}

const { title = 'Keep reading', items } = Astro.props;
---

{items.length > 0 && (
  <section class="related">
    <h2>{title}</h2>
    <div class="grid">
      {items.map((item) => (
        <a class="related-card" href={item.href}>
          {item.eyebrow && <span class="eyebrow">{item.eyebrow}</span>}
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <span class="read-more">Read →</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related {
    margin: 3rem 0 2rem;
  }
  .related h2 {
    margin-bottom: 1.25rem;
    font-size: 1.4rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.25rem;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .related-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    text-decoration: none;
  }
  .eyebrow {
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 700;
  }
  .related-card h3 {
    margin: 0.35rem 0 0.4rem;
    font-size: 1.05rem;
  }
  .related-card p {
    color: var(--ink-soft);
    font-size: 0.88rem;
    margin: 0 0 0.65rem;
    flex-grow: 1;
  }
  .read-more {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.88rem;
  }
</style>
